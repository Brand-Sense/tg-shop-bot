@dp.callback_query(F.data == "cart")
async def on_cart(c: CallbackQuery):
    db = await get_db()
    cart = await get_cart(db, c.from_user.id)
    if not cart:
        await c.message.edit_text("🛒 Корзина пуста.", reply_markup=categories_kb())
        await c.answer()
        return
    lines, total = ["🛒 Корзина:"], 0
    for pid, qty in cart.items():
        prod = next((p for p in CATALOG if p.id == pid), None)
        if not prod:
            continue
        line_sum = prod.price_cents * qty
        total += line_sum
        lines.append(f"• {_short_title(prod.title)} × {qty} = {money(line_sum)}")
    lines.append(f"\nИтого: {money(total)}")
    await c.message.edit_text("\n".join(lines), reply_markup=cart_kb(cart))
    await c.answer()

