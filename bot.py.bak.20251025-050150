def money(cents: int) -> str:
    rub = cents // 100
    return f"{rub:,} ₽".replace(",", " ")

def _short_title(title: str) -> str:
    t = title.replace(" (Казахстан)", "")
    t = t.split(" — ")[0].strip()
    return t

async def get_db():
    db = await aiosqlite.connect("shop.db")
    await db.execute("PRAGMA journal_mode=WAL;")
    await db.execute(CREATE_CART_TABLE)
    await db.execute(CREATE_ORDERS_TABLE)
    await db.execute(CREATE_ORDER_ITEMS)
    await db.commit()
    return db

async def get_cart(db, user_id: int) -> Dict[str, int]:
    cart = {}
    async with db.execute("SELECT product_id, qty FROM cart_items WHERE user_id=?", (user_id,)) as cur:
        async for pid, qty in cur:
            cart[pid] = qty
    return cart

async def add_to_cart(db, user_id: int, product_id: str, qty: int = 1):
    await db.execute(
        "INSERT INTO cart_items(user_id, product_id, qty) VALUES(?,?,?) "
        "ON CONFLICT(user_id, product_id) DO UPDATE SET qty = qty + ?",
        (user_id, product_id, qty, qty),
    )
    await db.commit()

async def remove_from_cart(db, user_id: int, product_id: str, qty: int = 1):
    async with db.execute("SELECT qty FROM cart_items WHERE user_id=? AND product_id=?", (user_id, product_id)) as cur:
        row = await cur.fetchone()
        if not row:
            return
        new_qty = row[0] - qty
    if new_qty > 0:
        await db.execute("UPDATE cart_items SET qty=? WHERE user_id=? AND product_id=?", (new_qty, user_id, product_id))
    else:
        await db.execute("DELETE FROM cart_items WHERE user_id=? AND product_id=?", (user_id, product_id))
    await db.commit()

async def clear_cart(db, user_id: int):
    await db.execute("DELETE FROM cart_items WHERE user_id=?", (user_id,))
    await db.commit()

def resolve_media(name: Optional[str]):
    if not name:
        return None
    p = MEDIA_DIR / name
    if p.exists():
        return p
    stem = Path(name).stem
    for ext in (".png", ".jpg", ".jpeg", ".PNG", ".JPG", ".JPEG"):
        cand = MEDIA_DIR / f"{stem}{ext}"
        if cand.exists():
            return cand
    norm = re.sub(r"[^a-z0-9]", "", stem.lower())
    for f in MEDIA_DIR.glob("*"):
        if f.is_file():
            fn = re.sub(r"[^a-z0-9]", "", f.stem.lower())
            if fn == norm or norm in fn:
                return f
    return None

