@dp.message(Checkout.address)
async def finalize_order(m: Message, state: FSMContext):
    db = await get_db()
    address = m.text.strip()
    await state.update_data(address=address)
    data = await state.get_data()
    cart = await get_cart(db, m.from_user.id)
    if not cart:
        await state.clear()
        await m.answer("Корзина пуста.")
        return
    total, items_for_msg = 0, []
    for pid, qty in cart.items():
        prod = next((p for p in CATALOG if p.id == pid), None)
        if not prod:
            continue
        line_sum = prod.price_cents * qty
        total += line_sum
        items_for_msg.append(f"• {_short_title(prod.title)} × {qty} = {money(line_sum)}")
    async with db.execute(
        "INSERT INTO orders(user_id, name, phone, address, email, total_cents) VALUES (?,?,?,?,?,?)",
        (m.from_user.id, data.get("name"), data.get("phone"), data.get("address"), "", total),
    ) as cur:
        await db.commit()
        order_id = cur.lastrowid
    for pid, qty in cart.items():
        prod = next((p for p in CATALOG if p.id == pid), None)
        if not prod:
            continue
        await db.execute(
            "INSERT INTO order_items(order_id, product_id, title, qty, price_cents) VALUES (?,?,?,?,?)",
            (order_id, prod.id, prod.title, qty, prod.price_cents),
        )
    await db.commit()
    await clear_cart(db, m.from_user.id)
    admin_text = (
        f"🆕 Заказ #{order_id}\n"
        f"Имя: {data.get('name')}\nТелефон: {data.get('phone')}\nАдрес: {data.get('address')}\n\n"
        + "\n".join(items_for_msg)
        + f"\n\nИтого: {money(total)}\nПрофиль: @{m.from_user.username or m.from_user.id}"
    )
    if ADMIN_ID:
        try:
            await Bot(BOT_TOKEN).send_message(ADMIN_ID, admin_text)
        except Exception:
            pass
    user_text = (
        "Спасибо! Заказ принят.\n\n"
        + "\n".join(items_for_msg)
        + f"\n\nИтого: {money(total)}\n\n"
        "В ближайшее время с Вами свяжется наш менеджер."
    )
    await m.answer(user_text)
    await state.clear()

