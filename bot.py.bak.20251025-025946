def money(cents: int) -> str:
    r = f"{cents // 100:,}".replace(",", " ")
    return f"{r} ₽"

def tg_tenge(cents: int) -> str:
    r = f"{cents // 100:,}".replace(",", " ")
    return f"{r} ₸"

def resolve_media(name: Optional[str]) -> Optional[FSInputFile]:
    if not name:
        return None
    p = MEDIA_DIR / f"{name}.png"
    if not p.exists():
        p = MEDIA_DIR / f"{name}.jpg"
    if not p.exists():
        return None
    return FSInputFile(p)

