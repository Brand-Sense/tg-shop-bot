# ---------- БД ----------
async def get_db():
    db = await aiosqlite.connect(BASE_DIR / "shop.db")
    await db.execute("""
    CREATE TABLE IF NOT EXISTS cart(
        user_id INTEGER,
        product_id TEXT,
        qty INTEGER,
        PRIMARY KEY(user_id, product_id)
    )""")
    await db.execute("""
    CREATE TABLE IF NOT EXISTS orders(
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        name TEXT,
        phone TEXT,
        address TEXT,
        total_cents INTEGER
    )""")
    await db.execute("""
    CREATE TABLE IF NOT EXISTS order_items(
        order_id INTEGER,
        product_id TEXT,
        qty INTEGER,
        price_cents INTEGER
    )""")
    await db.commit()
    return db

async def add_to_cart(db, user_id: int, pid: str, qty: int):
    cur = await db.execute("SELECT qty FROM cart WHERE user_id=? AND product_id=?", (user_id, pid))
    row = await cur.fetchone()
    if row:
        await db.execute("UPDATE cart SET qty=qty+? WHERE user_id=? AND product_id=?", (qty, user_id, pid))
    else:
        await db.execute("INSERT INTO cart(user_id, product_id, qty) VALUES(?,?,?)", (user_id, pid, qty))
    await db.commit()

async def clear_cart(db, user_id: int):
    await db.execute("DELETE FROM cart WHERE user_id=?", (user_id,))
    await db.commit()

async def get_cart(db, user_id: int) -> List[tuple]:
    cur = await db.execute("SELECT product_id, qty FROM cart WHERE user_id=?", (user_id,))
    return await cur.fetchall()

