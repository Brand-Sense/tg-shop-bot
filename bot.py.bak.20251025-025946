# --------- Оформление заказа (без email) ----------
from aiogram.fsm.state import State, StatesGroup
from aiogram.fsm.context import FSMContext

class Checkout(StatesGroup):
    name = State()
    phone = State()
    address = State()

@dp.callback_query(F.data=="checkout")
async def start_checkout(c: CallbackQuery, state: FSMContext):
    db = await get_db()
    if not (await get_cart(db, c.from_user.id)):
        await c.answer("Корзина пуста")
        return
    await state.set_state(Checkout.name)
    await c.message.answer("Введите ваше имя:")
    await c.answer()

@dp.message(Checkout.name)
async def take_name(m: Message, state: FSMContext):
    await state.update_data(name=m.text.strip())
    await state.set_state(Checkout.phone)
    await m.answer("Введите телефон:")

@dp.message(Checkout.phone)
async def take_phone(m: Message, state: FSMContext):
    await state.update_data(phone=re.sub(r"[^\d+]", "", m.text.strip()))
    await state.set_state(Checkout.address)
    await m.answer("Введите адрес доставки:")

@dp.message(Checkout.address)
async def take_addr(m: Message, state: FSMContext):
    await state.update_data(address=m.text.strip())
    data = await state.get_data()
    db = await get_db()
    items = await get_cart(db, m.from_user.id)
    if not items:
        await m.answer("Корзина пуста.")
        await state.clear()
        return
    total = 0
    order_lines = []
    for pid, qty in items:
        p = by_id(pid)
        if not p:
            continue
        s = p.price_cents * qty
        total += s
        order_lines.append(f"• {p.title} × {qty} = {money(s)}")
    async with db.execute(
        "INSERT INTO orders(user_id, name, phone, address, total_cents) VALUES(?,?,?,?,?)",
        (m.from_user.id, data.get("name"), data.get("phone"), data.get("address"), total),
    ) as cur:
        await db.commit()
        order_id = cur.lastrowid
    for pid, qty in items:
        p = by_id(pid)
        if not p:
            continue
        await db.execute("INSERT INTO order_items(order_id, product_id, qty, price_cents) VALUES(?,?,?,?)",
                         (order_id, pid, qty, by_id(pid).price_cents))
    await db.commit()
    await clear_cart(db, m.from_user.id)

    admin_text = (
        f"🆕 Заказ #{order_id}\n"
        f"Имя: {data.get('name')}\n"
        f"Телефон: {data.get('phone')}\n"
        f"Адрес: {data.get('address')}\n"
        + "\n".join(order_lines) +
        f"\n\nИтого: {money(total)}\nПрофиль: @{m.from_user.username or m.from_user.id}"
    )
    if ADMIN_ID:
        try:
            await bot.send_message(ADMIN_ID, admin_text)
        except Exception:
            pass

    user_text = "Спасибо! Заказ принят.\n\n" + "\n".join(order_lines) + f"\n\nИтого: {money(total)}\nВ ближайшее время с Вами свяжется наш менеджер."
    await m.answer(user_text, reply_markup=main_menu_kb())
    await state.clear()

